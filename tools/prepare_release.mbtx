----
import { "moonbitlang/x@0.5.7/fs" }
----

// Run after `moon build --release --target js`. Archives are made from this
// explicit staging tree, never from caches, credentials or the whole workspace.
fn main raise {
  let root = "_build/distribution/0.3.3/cli"
  for dir in ["_build/distribution", "_build/distribution/0.3.3", root, root + "/fixtures"] {
    if !@fs.path_exists(dir) { @fs.create_dir(dir) }
  }
  @fs.write_bytes_to_file(root + "/moonice.mjs",
    @fs.read_file_to_bytes("_build/js/release/build/cmd/main/main.js"))
  for name in ["events.icebundle.json", "deletes.icebundle.json",
    "partitioned.icebundle.json", "id-ge-10.filter.json", "ts-ge-march.filter.json"] {
    @fs.write_bytes_to_file(root + "/fixtures/" + name,
      @fs.read_file_to_bytes("fixtures/" + name))
  }
  for name in ["LICENSE", "THIRD_PARTY.md"] {
    @fs.write_bytes_to_file(root + "/" + name, @fs.read_file_to_bytes(name))
  }
  if !@fs.path_exists(root + "/licenses") { @fs.create_dir(root + "/licenses") }
  for name in ["moonbit-core-LICENSE", "moonbit-core-NOTICE", "moon-avro-LICENSE", "moon_yazi-LICENSE", "parquet-LICENSE", "moonstretch-MIT"] {
    @fs.write_bytes_to_file(root + "/licenses/" + name,
      @fs.read_file_to_bytes("licenses/" + name))
  }
  @fs.write_string_to_file(root + "/README.md",
    "# MoonIce CLI 0.3.3\n\nRequires Node.js (validated with Node 24).\n\n```sh\nnode moonice.mjs --help\nnode moonice.mjs scan fixtures/deletes.icebundle.json\nnode moonice.mjs scan fixtures/partitioned.icebundle.json --filter-file fixtures/ts-ge-march.filter.json\n```\n\nExpected: two surviving rows in each scan. CLI decodes bounded offline standard-file bundles. No catalog or S3 network client. Apache-2.0.\n\nSource, API, compatibility and provenance: https://github.com/Ridge-Lab/moonice/tree/v0.3.3\n")
  println("Staged CLI at " + root)
}
