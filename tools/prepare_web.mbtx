----
import { "moonbitlang/x@0.5.7/fs" }
----

fn main raise {
  @fs.write_bytes_to_file(
    "web/moonice.js",
    @fs.read_file_to_bytes("_build/js/release/build/bridge/bridge.js"),
  )
  for name in ["events.icebundle.json", "deletes.icebundle.json", "partitioned.icebundle.json"] {
    @fs.write_bytes_to_file(
      "web/" + name,
      @fs.read_file_to_bytes("fixtures/" + name),
    )
  }
  for dir in ["web/fixtures", "web/fixtures/duckdb"] {
    if !@fs.path_exists(dir) { @fs.create_dir(dir) }
  }
  for name in ["column-mapping.icebundle.json", "LICENSE"] {
    @fs.write_bytes_to_file("web/fixtures/duckdb/" + name,
      @fs.read_file_to_bytes("fixtures/duckdb/" + name))
  }
  for name in ["LICENSE", "THIRD_PARTY.md"] {
    @fs.write_bytes_to_file("web/" + name, @fs.read_file_to_bytes(name))
  }
  if !@fs.path_exists("web/licenses") { @fs.create_dir("web/licenses") }
  for name in ["moonbit-core-LICENSE", "moonbit-core-NOTICE", "moon-avro-LICENSE", "moon_yazi-LICENSE", "parquet-LICENSE", "moonstretch-MIT"] {
    @fs.write_bytes_to_file("web/licenses/" + name,
      @fs.read_file_to_bytes("licenses/" + name))
  }
  println("Web assets prepared in web/")
}
