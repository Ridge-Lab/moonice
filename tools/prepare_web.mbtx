import { "moonbitlang/x/fs" }

fn main raise {
  @fs.write_bytes_to_file(
    "web/moonice.js",
    @fs.read_file_to_bytes("_build/js/release/build/bridge/bridge.js"),
  )
  for name in ["events.icebundle.json", "deletes.icebundle.json"] {
    @fs.write_bytes_to_file(
      "web/" + name,
      @fs.read_file_to_bytes("fixtures/" + name),
    )
  }
  println("Web assets prepared in web/")
}
