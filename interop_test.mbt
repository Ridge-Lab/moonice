///|
test "read manifest lists and entries generated by PyIceberg" {
  let bundle = @moonice.open_bundle(reference_bundle)
  assert_eq(bundle.metadata.snapshots.length(), 3)
  let counts : Array[Int64] = []
  for snapshot in bundle.metadata.snapshots {
    let state = bundle.load_snapshot(snapshot_id=snapshot.id)
    let mut count = 0L
    for entry in state.entries {
      if entry.file.content == 0 {
        count += entry.file.record_count
      }
      assert_true(entry.status != 2)
    }
    counts.push(count)
  }
  assert_eq(counts, [3L, 5L, 4L])
}

///|
test "current schema and historical schema use stable field IDs" {
  let bundle = @moonice.open_bundle(reference_bundle)
  let current = bundle.load_snapshot()
  let historic = bundle.load_snapshot(
    snapshot_id=bundle.metadata.snapshots[0].id,
  )
  assert_eq(current.schema.field_named("region").id, 2)
  assert_eq(historic.schema.field_named("city").id, 2)
}

///|
test "missing manifest reports the actual object path" {
  let bundle = @moonice.open_bundle(reference_bundle)
  let path = bundle.metadata.snapshot().manifest_list
  bundle.files.remove(path)
  try bundle.load_snapshot() catch {
    @moonice.Invalid(code, actual, _) => {
      assert_eq(code, "MISSING_FILE")
      assert_eq(actual, path)
    }
  } noraise {
    _ => fail("Must not silently return an empty scan")
  }
}
